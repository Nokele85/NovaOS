*.egg-info/
.pytest_cache/
.yurios/
# your own live tests — run against your real setup, never committed
.live_tests/
build/
dist/

# her mind — seeded locally, its own git repo, never nested in this one
vault/

# multi-character runtime data (registries, Vaults, traces, cards, and media)
data/

