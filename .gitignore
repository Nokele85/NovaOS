desktop-shell/node_modules/

# coverage's database, written by scripts/test_map.py; the MAP is committed,
# the measurement it came from is not
.coverage
.coverage.*
# Local credential imports from the legacy Rook environment. Never commit.
.env
.env.local
secrets/
YuriOS-private-secrets/
