web/live2d/vendor/

# her photos — generated locally (SPEC §7.6), personal like the corpus
selfies/

# frontend build (Vite) + npm — regenerated by `cd web && npm ci && npm run build`
web/node_modules/
web/dist/

# the Windows desktop shell's electron.exe — installed by WINDOWS' node, per
